rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // User Validator
    function isValidUser() {
      return request.resource.data.uid == request.auth.uid &&
             request.resource.data.email is string;
    }

    // Question Validator
    function isValidQuestion() {
      let data = request.resource.data;
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.imageBase64 is string &&
             data.subject is string &&
             data.chapter is string &&
             data.timestamp is number &&
             (!('isSolved' in data) || data.isSolved is bool) &&
             (!('tags' in data) || data.tags is list) &&
             (!('notes' in data) || data.notes is string) &&
             (!('isUncategorized' in data) || data.isUncategorized is bool);
    }

    // PdfSession Validator
    function isValidPdfSession() {
      let data = request.resource.data;
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.fileName is string &&
             data.fileType is string &&
             data.pageNumber is number &&
             (!('scale' in data) || data.scale is number || data.scale == null) &&
             (!('theme' in data) || data.theme is string || data.theme == null) &&
             (!('timerMinutes' in data) || data.timerMinutes is number || data.timerMinutes == null) &&
             (!('timeLeft' in data) || data.timeLeft is number || data.timeLeft == null) &&
             (!('fileUrl' in data) || data.fileUrl is string || data.fileUrl == null) &&
             (!('subject' in data) || data.subject is string || data.subject == null) &&
             (!('chapter' in data) || data.chapter is string || data.chapter == null) &&
             (!('boxName' in data) || data.boxName is string || data.boxName == null) &&
             (!('orderIndex' in data) || data.orderIndex is number || data.orderIndex == null) &&
             (!('deletedAt' in data) || data.deletedAt is number || data.deletedAt == null) &&
             (!('lastOpened' in data) || data.lastOpened is number);
    }

    // Mistake Validator
    function isValidMistake() {
      let data = request.resource.data;
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.text is string &&
             data.timestamp is number &&
             (!('subject' in data) || data.subject is string);
    }
    
    // Test Validator
    function isValidTest() {
      let data = request.resource.data;
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.timestamp is number &&
             data.type is string &&
             data.category is string &&
             data.score is number &&
             data.maxScore is number &&
             (!('percentile' in data) || data.percentile is number) &&
             (!('rank' in data) || data.rank is number) &&
             data.physics is map &&
             data.chemistry is map &&
             data.maths is map &&
             data.questions is list;
    }

    // Setting Validator
    function isValidSetting() {
      let data = request.resource.data;
      return (!('tags' in data) || data.tags is list);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && isValidUser();
      
      match /questions/{questionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidQuestion();
      }
      
      match /pdf_sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPdfSession();
      }

      match /mistakes/{mistakeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMistake();
      }

      match /tests/{testId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTest();
      }

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSetting();
      }

      match /chapter_boxes/{boxId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId);
      }
    }
  }
}
